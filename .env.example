# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- Telegram ---
BOT_TOKEN=
# Если провайдер блокирует api.telegram.org:
# 1. Запустите Киберщит — он поднимает локальный SOCKS5 на 127.0.0.1:10808,
#    и бот подхватит его автоматически.
# 2. Либо задайте прокси явно:
# TELEGRAM_PROXY=socks5://127.0.0.1:10808
# Отключить автоподхват Киберщита: TELEGRAM_PROXY_AUTODETECT=0
# Для socks5:// используется aiohttp-socks (уже в requirements.txt)

# --- База данных ---
# Локальное демо (по умолчанию):
DATABASE_URL=sqlite:///tea_shop.db

# Supabase (Session pooler, порт 5432). Раскомментируйте и заполните:
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Публичный HTTPS-адрес витрины и webhook ---
# Локально: https://<...>.ngrok-free.app (без слэша на конце).
# Можно оставить пустым — адрес подхватится из локального API ngrok
# или из REPLIT_DEV_DOMAIN на Replit.
BASE_URL=

# --- Webhook ---
WEBHOOK_PATH=/webhook
# Если пусто, сервер сгенерирует секрет сам.
# Для PythonAnywhere обязательно задайте постоянное значение.
WEBHOOK_SECRET=

# Удалять webhook при остановке сервера (1/0).
DELETE_WEBHOOK_ON_SHUTDOWN=1

# --- Сервер ---
HOST=0.0.0.0
PORT=8000
MODE=webhook

# Для локальной проверки витрины без Telegram API:
# BOT_TOKEN можно не заполнять, сервер подставит офлайн-заглушку.
# SKIP_TELEGRAM=1
